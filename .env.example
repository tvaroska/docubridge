# Canonical index of every environment variable the Bridge reads.
#
# This file is a REFERENCE, not a runtime config: nothing loads it automatically. Copy
# what you need into a gitignored `.env` (or just export it in your shell); the frontend
# apps read their `VITE_*` vars from the process env or `frontend/<app>/.env`.
#
# A purely local run needs NONE of this — `scripts/run-*.sh` exports the handful of
# defaults that matter (see docs/local-dev.md). The GCP blocks are injected by the
# deployed runtime from Terraform outputs (scripts/deploy.sh prints them).
#
# NEVER commit real values. The only secret below is the Cloud SQL DSN (it embeds the
# password); it is passed through the environment only and never written to disk
# (CRITICAL.md).

# ---------------------------------------------------------------------------
# Seams — the nine managed-service boundaries
# ---------------------------------------------------------------------------
# Every seam resolves `BRIDGE_SEAM_<NAME>` first, then `BRIDGE_SEAM_MODE`, then `local`.
# The per-seam override is the point: move ONE boundary onto a managed service at a time.
BRIDGE_SEAM_MODE=local                 # local | gcp
# BRIDGE_SEAM_SESSIONS=
# BRIDGE_SEAM_TASK_STORE=
# BRIDGE_SEAM_EXCHANGE_STORE=
# BRIDGE_SEAM_SKILL_REGISTRY=
# BRIDGE_SEAM_MEMORY_BANK=
# BRIDGE_SEAM_SCHEDULER=
# BRIDGE_SEAM_A2A_CLIENT=
# BRIDGE_SEAM_EXTRACTION=
# BRIDGE_SEAM_EMAIL_INGRESS=

# ---------------------------------------------------------------------------
# Local adapters
# ---------------------------------------------------------------------------
# Skill Registry root — the folder of Agent Skills the Bridge loads at runtime.
# Default: the repo's own `skills/` dir.
# BRIDGE_SKILLS_DIR=./skills

# Durable local stores. Unset = in-memory (fine for a dev run; state dies with the
# process). Set to an async Postgres DSN to exercise the durable path locally.
# BRIDGE_SESSION_DB_URL=postgresql+asyncpg://bridge:bridge@127.0.0.1:5432/bridge
# BRIDGE_TASK_DB_URL=postgresql+asyncpg://bridge:bridge@127.0.0.1:5432/bridge
# Local ADK MemoryService SQLite file path (unset = InMemoryMemoryService).
# BRIDGE_MEMORY_DB_PATH=./.bridge-memory.sqlite

# Address-agent wake index (deploy-resume): a file path, unset = in-memory.
# BRIDGE_WAKE_INDEX_PATH=

# ---------------------------------------------------------------------------
# Extraction + model
# ---------------------------------------------------------------------------
# Engine selection is its own axis (a capability, not local↔gcp). The LOCAL extraction
# adapter is always the deterministic fixture engine over `wiki/evals/`; this var
# selects the engine for the GCP adapter: gemini (default) | docai (Gemini with a
# Document AI OCR pre-pass for scanned/raster PDFs; needs BRIDGE_DOCAI_PROCESSOR, no
# fallback) | fixture (explicit opt-in — the gcp adapter never silently falls back).
# BRIDGE_EXTRACTION_ENGINE=gemini

# The client's existing Document AI processor, by full resource name (docai engine
# only; the regional endpoint is derived from it). Terraform: var.docai_processor.
# BRIDGE_DOCAI_PROCESSOR=projects/<client-project>/locations/us/processors/<id>

# Large documents (Gemini engine): an explicit output budget on every request, and an
# inline PDF longer than CHUNK_PAGES is extracted as page windows (0 = no proactive
# windows; a MAX_TOKENS truncation still bisects). Concurrency = windows in flight.
# BRIDGE_EXTRACTION_MAX_OUTPUT_TOKENS=32768
# BRIDGE_EXTRACTION_CHUNK_PAGES=8
# BRIDGE_EXTRACTION_CHUNK_CONCURRENCY=4

# The model id used by the Gemini extraction engine and the ADK agents.
# BRIDGE_MODEL=gemini-2.5-flash

# The Gemini path builds a `google.genai.Client()` lazily, which reads the standard
# google-genai env. Either an API key, or Vertex + a project/location.
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Edge / consumer wiring
# ---------------------------------------------------------------------------
# The origin the Agent Card advertises. Deployed, this MUST be the Gateway-authorized
# URL: a consumer's RemoteA2aAgent enforces same-origin on a network-fetched card
# (adk >= 2.7). Unset = http://localhost:8000/ ; scripts/run-core.sh sets it to the
# served origin.
# BRIDGE_PUBLIC_URL=http://127.0.0.1:8000/

# The card URL the Agent Console consumer dials. Unset = the mock edge on :8001;
# scripts/run-console.sh points it at the real edge on :8000. The mock->real swap is
# nothing but this URL.
# BRIDGE_CARD_URL=http://127.0.0.1:8000/.well-known/agent-card.json

# Edge routing mode. deterministic (default; unset/blank) = every message runs on the
# model-free Collector / Path-A validate-only. hybrid = structured requests and document
# submissions still run model-free; a text-only message (e.g. "delete bill.pdf", "this is
# the wrong file", "I need a person") is handed to the document_bridge LlmAgent, which needs
# a model (BRIDGE_MODEL + GOOGLE_API_KEY or Vertex). Any other value fails app start.
# BRIDGE_EDGE_MODE=deterministic

# Best-effort satisfaction proposal (COLL-2). off (default; unset/blank) = status.outstanding
# lists each non-accepted entry. llm = a model (BRIDGE_MODEL) reads the process skill's
# bridge-satisfaction prose each collect turn and proposes required/optional/satisfied items
# (advisory; done is never minted). Any other value fails app start.
# BRIDGE_SATISFACTION=off

# Reviewer principals allowed to resolve a parked human review on the hybrid edge
# (comma/space-separated authenticated A2A principal names). Fail closed: unset/empty =
# every HumanReviewResolution is refused. The principal comes from the server's
# authentication backend, never from the resolution payload.
# BRIDGE_EDGE_REVIEWERS=

# Push-notification webhook allowlist (comma-separated hosts). The SSRF guard also
# rejects any webhook resolving to a non-global IP, allowlist or not.
# BRIDGE_PUSH_ALLOWLIST=

# Inbound-artifact fetch allowlist (comma-separated hosts / host:port), the sibling
# escape hatch on the OTHER egress leg: the artifact resolver GETs a party's
# by-reference document, and refuses — with no request issued — any host resolving to
# a non-global IP (loopback, private, the 169.254.169.254 metadata endpoint) unless it
# is listed here. Every redirect hop is re-validated against the same list.
# BRIDGE_FETCH_ALLOWLIST=127.0.0.1:8000

# Allow `file:///abs/path` artifact URIs (local-dev only). Off unless exactly "1": a
# counterparty submitting file:///etc/passwd would otherwise get host file contents
# read by the model and laundered back through the extracted key_fields.
# BRIDGE_ALLOW_FILE_URI=1

# Cloud Run container entrypoint only (`serve_container`): the port to bind on 0.0.0.0.
# PORT=8080

# ---------------------------------------------------------------------------
# Email intake (email_ingress seam) — the dedicated intake mailbox edge
# ---------------------------------------------------------------------------
# Off unless configured: every var below is required by the path that reads it, and a
# missing one raises naming the env — never a silent default.
# Local adapter landing dir (the GCP adapter lands in BRIDGE_EMAIL_BUCKET instead).
# BRIDGE_EMAIL_DIR=./.email-landing
# The intake mailbox carriers reply to; each leg's token rides as a plus-tag
# (rfp-quotes+<token>@…) with a [ref:<token>] subject tag as the fallback.
# BRIDGE_EMAIL_MAILBOX=rfp-quotes@example.com
# HMAC key for the RFP correlation token (SECRET — Secret Manager when deployed).
# BRIDGE_EMAIL_TOKEN_SECRET=
# Per-message size cap in bytes (default 25 MiB).
# BRIDGE_EMAIL_MAX_BYTES=26214400
# Microsoft Graph change notifications — Mail.Read app scoped by an Application Access
# Policy to the intake mailbox only. Tenant + client id are not secrets.
# BRIDGE_EMAIL_GRAPH_TENANT=
# BRIDGE_EMAIL_GRAPH_CLIENT_ID=
# BRIDGE_EMAIL_GRAPH_CLIENT_SECRET=     # SECRET
# BRIDGE_EMAIL_CLIENT_STATE=            # SECRET — subscription clientState (<= 128 chars)

# ---------------------------------------------------------------------------
# GCP resources — injected by the deployed runtime from Terraform outputs
# ---------------------------------------------------------------------------
# The gcp adapters REFUSE to start without these rather than falling back silently
# (the session-affinity trap and its analogues); that refusal is a correctness
# invariant, not strictness for its own sake.
# DATABASE_URL=                        # Cloud SQL DSN (SECRET — from Secret Manager)
# BRIDGE_SKILLS_BUCKET=                # Skill Registry GCS bucket
# BRIDGE_ARTIFACT_BUCKET=              # artifact store bucket (direct-serve -> signed URL)
# BRIDGE_TASKS_QUEUE=                  # Cloud Tasks queue (projects/…/locations/…/queues/…)
# BRIDGE_FOLLOWUP_CALLBACK_URL=        # the push callback the scheduler targets
# BRIDGE_RUNTIME_SA_EMAIL=             # OIDC signer for scheduler pushes AND a2a_client
# BRIDGE_GATEWAY_HOST=                 # the authorized gateway host for outbound A2A
# BRIDGE_EMAIL_BUCKET=                 # email_ingress landing bucket (create-only)
# BRIDGE_VAULT_BUCKET=                 # Zone 3 immutable WORM Audit Vault GCS bucket
# BRIDGE_OPERATIONAL_DB_URL=           # Zone 3 AlloyDB / Postgres bi-temporal operational store DSN
# BRIDGE_KNOWLEDGE_CATALOG_BACKEND=    # Zone 6 Knowledge Catalog backend (local | dataplex)
# BRIDGE_AGENT_ENGINE_ID=              # Vertex AI Agent Engine ID or full reasoningEngines/... resource name (selects VertexAiSessionService + VertexAiMemoryBankService)
# BRIDGE_AGENT_ENGINE_REMOTE=          # Set "1" to stream LlmLeg turns through the deployed Vertex AI Agent Engine ReasoningEngine (async_stream_query)
# BRIDGE_AGENT_ENGINE_A2A=             # Set "1" to delegate A2A discovery (/.well-known/agent-card.json) and JSON-RPC POST / to BridgeA2aAgentEngine on Vertex AI Agent Engine (Option B)

# ---------------------------------------------------------------------------
# Test gates — opt-in suites (all default off; the suite is green without them)
# ---------------------------------------------------------------------------
# BRIDGE_TEST_GCP=1                    # un-skips the [gcp] seam params (needs live GCP)
# BRIDGE_GCP_TEST_DSN=                 # Cloud SQL DSN for the durable-seam params
# BRIDGE_TEST_GEMINI=1                 # un-skips the live Gemini corpus parity test
# BRIDGE_DEPLOYED_EDGE_URL=            # deployed Address golden runs against this edge

# ---------------------------------------------------------------------------
# Frontend (Vite) — read at dev-server start; scripts/run-all.sh exports these
# ---------------------------------------------------------------------------
# Each app's backend host:
# VITE_PORTAL_URL=http://localhost:8001
# VITE_CONSOLE_URL=http://localhost:8002
# VITE_DASHBOARD_URL=http://localhost:8003
# VITE_TIMEWARP_URL=http://localhost:8004
# The presenter stage embeds the other three apps (Split-Screen mode):
# VITE_PORTAL_APP_URL=http://localhost:5173
# VITE_CONSOLE_APP_URL=http://localhost:5174
# VITE_DASHBOARD_APP_URL=http://localhost:5175
