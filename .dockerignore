# Keep the image lean and the isolation clean. agents/ is excluded on principle —
# the Bridge core never depends on consumers (isolation invariant); it is also
# never COPYed in the Dockerfile.
.venv/
**/__pycache__/
**/*.pyc
.git/
.github/
.claude/
agents/
frontend/
node_modules/
terraform/
tests/
docs/
design/
spec/
scripts/
*.md
.python-version
.ruff_cache/
.pytest_cache/
